# Normaliza finales de linea para evitar conflictos entre Windows y WSL
* text=auto eol=lf

# Archivos de texto
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.svg    text eol=lf

# Binarios (no tocar)
*.jpg    binary
*.jpeg   binary
*.png    binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.mp4    binary
*.zip    binary
